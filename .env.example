FIRE_ENV=development
FIRE_DATABASE_URL=sqlite:///./.data/fire_inspect.db
FIRE_STORAGE_BACKEND=local
FIRE_LOCAL_STORAGE_PATH=.data/objects
FIRE_REDIS_URL=redis://localhost:6379/0
FIRE_TASK_ALWAYS_EAGER=true
FIRE_AI_PROVIDER=mock
FIRE_SESSION_SECURE=false
FIRE_CORS_ORIGINS=["http://localhost:5173"]

# Change these before exposing a Compose deployment.
FIRE_POSTGRES_DB=fire_inspect
FIRE_POSTGRES_USER=fire_inspect
FIRE_POSTGRES_PASSWORD=fire-inspect-change-me

# S3/MinIO production settings
FIRE_S3_ENDPOINT=http://minio:9000
FIRE_S3_ACCESS_KEY=fireinspect
FIRE_S3_SECRET_KEY=change-me
FIRE_S3_BUCKET=fire-inspect
FIRE_S3_REGION=us-east-1

# OpenAI-compatible providers (optional; mock is the safe default)
FIRE_OPENAI_BASE_URL=
FIRE_OPENAI_API_KEY=
FIRE_LLM_MODEL=
FIRE_EMBEDDING_MODEL=
FIRE_VISION_MODEL=
FIRE_TRANSCRIPTION_MODEL=
