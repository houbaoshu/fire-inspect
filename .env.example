# ===== AI 端点（五组独立可配；组内缺省时回落 DASHSCOPE_*）=====
# 网关基地址与密钥（内网 MaaS 网关，OpenAI 兼容协议）
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=

# 语音转写（已验证 qwen3-asr-flash，勿换未验证模型）
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=qwen3-asr-flash

# LLM（事实提取/文书生成/问·答归属/AI 助手）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash

# 视觉（关键帧描述/照片说明候选）
VL_BASE_URL=
VL_API_KEY=
VL_MODEL=qwen3-vl-flash

# Embedding（知识库向量）
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024

# OCR（可选：扫描版知识文档解析兜底）
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=qwen3.5-ocr

# ===== 应用 =====
DATABASE_URL=postgresql+psycopg://fire:fire@localhost:5432/fire_inspect
SESSION_SECRET=please-change-me
# 转写窗口参数（ASR-VERIFICATION §4：硬切边界失真，1s 重叠缓解）
ASR_WINDOW_SEC=10
ASR_OVERLAP_SEC=1
# 关键帧
KEYFRAME_INTERVAL_SEC=3
KEYFRAME_BLUR_THRESHOLD=15
KEYFRAME_DARK_THRESHOLD=35
KEYFRAME_MAX=30
