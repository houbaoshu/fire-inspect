APP_ENV=development
DATABASE_URL=postgresql+psycopg://fire_inspect:fire_inspect@postgres:5432/fire_inspect
REDIS_URL=redis://redis:6379/0
TASK_MODE=rq
STORAGE_BACKEND=s3
STORAGE_ROOT=/app/data
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=fire-inspect
S3_SECRET_KEY=change-me-now
S3_BUCKET=fire-inspect
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Optional approved AI endpoints. Capability-specific URLs override AI_BASE_URL.
# Leave model names blank to use safe local fallbacks.
AI_BASE_URL=
AI_CHAT_BASE_URL=
AI_TRANSCRIPTION_BASE_URL=
AI_EMBEDDING_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=384
