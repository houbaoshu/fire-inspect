# Copy values into the process environment or your protected deployment secret store.
# Never commit real values and never use these placeholders in production.
# Inject through the parent process or a protected secret store.  Do not rename this
# example to .env in production. URL-reserved characters such as @:/?#% are supported.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DISTINCT_24_CHAR_BOOTSTRAP_SECRET
FIRE_INSPECT_DB_MIGRATION_PASSWORD=REPLACE_WITH_DISTINCT_24_CHAR_MIGRATION_SECRET
FIRE_INSPECT_DB_RUNTIME_PASSWORD=REPLACE_WITH_DISTINCT_24_CHAR_RUNTIME_SECRET
FIRE_INSPECT_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
FIRE_INSPECT_ALLOWED_HOSTS=fire-inspect.internal
FIRE_INSPECT_PUBLIC_BASE_URL=https://fire-inspect.internal
FIRE_INSPECT_CSRF_TRUSTED_ORIGINS=https://fire-inspect.internal
FIRE_INSPECT_WORKER_CONCURRENCY=2
FIRE_INSPECT_WEB_WORKERS=3
FIRE_INSPECT_WEB_TIMEOUT=600
FIRE_INSPECT_WEB_GRACEFUL_TIMEOUT=30
FIRE_INSPECT_MAX_UPLOAD_BYTES=536870912
FIRE_INSPECT_MAX_INSPECTION_BYTES=2147483648
FIRE_INSPECT_MAX_MATERIALS_PER_INSPECTION=50
FIRE_INSPECT_MAX_MEDIA_DURATION_MS=7200000
FIRE_INSPECT_MAX_CONCURRENT_UPLOADS=4
# FIRE_INSPECT_HTTP_PORT=80
# FIRE_INSPECT_HTTPS_PORT=443

# Each AI capability is independent. Leave disabled for the manual path.
FIRE_INSPECT_ASR_PROVIDER=disabled
# FIRE_INSPECT_ASR_ENDPOINT=https://ai-gateway.internal/asr
# FIRE_INSPECT_ASR_MODEL=approved-asr-model
# FIRE_INSPECT_ASR_API_KEY=INJECT_FROM_SECRET_STORE
# FIRE_INSPECT_ASR_TIMEOUT=120
FIRE_INSPECT_LLM_PROVIDER=disabled
# FIRE_INSPECT_LLM_ENDPOINT=https://ai-gateway.internal/llm
# FIRE_INSPECT_LLM_MODEL=approved-llm-model
# FIRE_INSPECT_LLM_API_KEY=INJECT_FROM_SECRET_STORE
# FIRE_INSPECT_LLM_TIMEOUT=120
FIRE_INSPECT_VISION_PROVIDER=disabled
# FIRE_INSPECT_VISION_ENDPOINT=https://ai-gateway.internal/vision
# FIRE_INSPECT_VISION_MODEL=approved-vision-model
# FIRE_INSPECT_VISION_API_KEY=INJECT_FROM_SECRET_STORE
# FIRE_INSPECT_VISION_TIMEOUT=120
FIRE_INSPECT_EMBEDDING_PROVIDER=disabled
