FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl ffmpeg libreoffice-writer fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock* ./
RUN pip install --no-cache-dir uv && uv sync --frozen --no-dev
COPY alembic.ini ./
COPY backend ./backend
COPY templates ./templates
ENV PYTHONPATH=/app/backend
CMD ["sh", "-c", "uv run python -m app.prestart && uv run uvicorn app.main:app --host 0.0.0.0 --port 8000"]
